rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to validate basic IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Validation for Militar
    function isValidMilitar(data) {
      return data.keys().hasAll(['id', 'nome', 'nomeGuerra', 'patente', 'funcao', 'quadro', 'role', 'statusProntidao'])
        && data.id is string
        && data.nome is string
        && data.nomeGuerra is string
        && data.patente is string
        && data.funcao is string
        && data.quadro is string
        && data.role is string
        && data.statusProntidao is string;
    }

    // Validation for Escala
    function isValidEscala(data) {
      return data.keys().hasAll(['id', 'militarId', 'postoServico', 'data', 'horaInicio', 'horaFim', 'turno'])
        && data.id is string
        && data.militarId is string
        && data.postoServico is string
        && data.data is string
        && data.horaInicio is string
        && data.horaFim is string
        && data.turno is string;
    }

    // Validation for Permuta
    function isValidPermuta(data) {
      return data.keys().hasAll(['id', 'escalaSubstituidaId', 'militarSubstituidoId', 'militarSubstitutoId', 'dataSolicitacao', 'dataRealizacao', 'horaInicio', 'horaFim', 'turno', 'postoServico', 'status', 'protocoloId', 'qrCode', 'auditoriaHash'])
        && data.id is string
        && data.escalaSubstituidaId is string
        && data.militarSubstituidoId is string
        && data.militarSubstitutoId is string
        && data.dataSolicitacao is string
        && data.dataRealizacao is string
        && data.horaInicio is string
        && data.horaFim is string
        && data.turno is string
        && data.postoServico is string
        && data.status is string
        && data.protocoloId is string
        && data.qrCode is string
        && data.auditoriaHash is string;
    }

    // Validation for Alerta
    function isValidAlerta(data) {
      return data.keys().hasAll(['id', 'prioridade', 'titulo', 'conteudo', 'datahora'])
        && data.id is string
        && data.prioridade is string
        && data.titulo is string
        && data.conteudo is string
        && data.datahora is string;
    }

    // Validation for BlockchainLog (Audit Logs)
    function isValidLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'tipoEvento', 'evento', 'militarEnvolvido', 'hashAnterior', 'hashAtual'])
        && data.id is string
        && data.timestamp is string
        && data.tipoEvento is string
        && data.evento is string
        && data.militarEnvolvido is string
        && data.hashAnterior is string
        && data.hashAtual is string;
    }

    // Validation for ChatMessage
    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'deMilitarId', 'paraMilitarId', 'conteudo', 'timestamp', 'criptografada', 'chaveCripto'])
        && data.id is string
        && data.deMilitarId is string
        && data.paraMilitarId is string
        && data.conteudo is string
        && data.timestamp is string
        && data.criptografada is bool
        && data.chaveCripto is string;
    }

    // Default catch-all rule (deny everything by default)
    match /{document=**} {
      allow read, write: if false;
    }

    // Militares Collection
    match /militares/{militarId} {
      allow read: if true;
      allow write: if isValidId(militarId) && isValidMilitar(request.resource.data);
    }

    // Escalas Collection
    match /escalas/{escalaId} {
      allow read: if true;
      allow write: if isValidId(escalaId) && isValidEscala(request.resource.data);
    }

    // Permutas Collection
    match /permutas/{permutaId} {
      allow read: if true;
      allow write: if isValidId(permutaId) && isValidPermuta(request.resource.data);
    }

    // Alertas Collection
    match /alertas/{alertaId} {
      allow read: if true;
      allow write: if isValidId(alertaId) && isValidAlerta(request.resource.data);
    }

    // Logs Collection
    match /logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidLog(request.resource.data);
      allow delete: if true; // Allowed to clear history under admin actions
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read: if true;
      allow write: if isValidId(messageId) && isValidMessage(request.resource.data);
    }

    // Backups Collection
    match /backups/{backupId} {
      allow read: if true;
      allow write: if isValidId(backupId);
    }

    // Config Collection
    match /config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }
  }
}
