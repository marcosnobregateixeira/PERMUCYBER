rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check valid string formats and sizes
    function isValidString(val, minSize, maxSize) {
      return val is string && val.size() >= minSize && val.size() <= maxSize;
    }

    // Helper for checking if IDs are formatted correctly to prevent ID poisoning
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // PERMISSÃO TOTAL PARA DESENVOLVIMENTO/FALLBACK
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
